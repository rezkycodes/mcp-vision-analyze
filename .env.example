# ============================================
# MCP Vision Analyze — Configuration
# ============================================
# ONLY OpenRouter is supported (no Google AI Studio needed)
#
#   Provider         Cost              Rate Limit    Get Key
#   ─────────────    ──────────────    ──────────    ─────────────────────────
#   openrouter       ~$0.0001/image    Unlimited     openrouter.ai/keys
#
# ============================================

# Provider: "openrouter" (only option)
VISION_PROVIDER=openrouter

# ── OpenRouter ──────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
